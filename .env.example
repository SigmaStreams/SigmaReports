# Discord bot token
DISCORD_TOKEN=your_token_here

# Channel IDs
STAFF_CHANNEL_ID=123456789012345678
SUPPORT_CHANNEL_ID=123456789012345678
TICKETS_CATEGORY_ID=
MODLOGS_CHANNEL_ID=123456789012345678

# Role allowed to manage reports and blocks
STAFF_ROLE_ID=123456789012345678
# Role whose members can select VOD remux libraries
SS_VOD_REMUX_ROLE_ID=123456789012345678

# Channels where /report-* commands are allowed
REPORTS_CHANNEL_IDS=123456789012345678,1457895623553716255
# Legacy single-channel fallback (optional; use REPORTS_CHANNEL_IDS instead when possible)
REPORTS_CHANNEL_ID=

# Staff ping settings
STAFF_PING_USER_IDS=886584649013411880,1229271933736976395
PUBLIC_UPDATES=true
DOUBLE_CONFIRMATION=false

# Storage
DB_PATH=./data/reports.sqlite3

# Optional integrations
TMDB_BEARER_TOKEN=
TVDB_KEY=
TV_STAFF_PING_USER_IDS=
VOD_STAFF_PING_USER_IDS=
RESPONSES_CHANNEL_ID=
TRANSCRIPTS_CHANNEL_ID=

# Ticket closure grace period in minutes (positive whole number; default 10)
TICKET_CLOSE_DELAY_MINUTES=10

# Optional staff web dashboard (disabled by default)
WEB_DASHBOARD_ENABLED=false
WEB_DASHBOARD_HOST=127.0.0.1
WEB_DASHBOARD_PORT=8767
# HTTPS public origin, or http://127.0.0.1:8767 for an SSH tunnel
WEB_DASHBOARD_URL=
# Defaults to this bot's Discord application ID when omitted
WEB_DASHBOARD_CLIENT_ID=
# Discord OAuth client secret; private and server-side only
WEB_DASHBOARD_CLIENT_SECRET=
